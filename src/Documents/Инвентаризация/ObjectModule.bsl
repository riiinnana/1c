Процедура ЗаполнитьПоОстаткам()
    Товары.Очистить();
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ
    |    Остатки.Ячейка,
    |    Остатки.Номенклатура,
    |    Остатки.КоличествоОстаток КАК Количество
    |ИЗ
    |    РегистрНакопления.ОстаткиТоваров.Остатки(, Склад = &Склад) КАК Остатки";
    Запрос.УстановитьПараметр("Склад", Склад);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Строка = Товары.Добавить();
        Строка.Номенклатура = Выборка.Номенклатура;
        Строка.Ячейка = Выборка.Ячейка;
        Строка.УчетноеКоличество = Выборка.Количество;
        Строка.ФактическоеКоличество = Выборка.Количество; // человек потом поправит вручную
    КонецЦикла;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Движения.ОстаткиТоваров.Записывать = Истина;
    Для Каждого Строка Из Товары Цикл
        Отклонение = Строка.ФактическоеКоличество - Строка.УчетноеКоличество;
        Если Отклонение = 0 Тогда
            Продолжить;
        КонецЕсли;

        Движение = Движения.ОстаткиТоваров.Добавить();
        Движение.Склад = Склад;
        Движение.Ячейка = Строка.Ячейка;
        Движение.Номенклатура = Строка.Номенклатура;
        Движение.Количество = ?(Отклонение < 0, -Отклонение, Отклонение);
        Если Отклонение > 0 Тогда
            Движение.ВидДвижения = ВидДвиженияНакопления.Приход; // излишек
        Иначе
            Движение.ВидДвижения = ВидДвиженияНакопления.Расход; // недостача
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры


