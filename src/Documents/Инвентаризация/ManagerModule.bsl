Функция СформироватьАктРасхождения(ОбъектДокумента) Экспорт
    Макет = Документы.Инвентаризация.ПолучитьМакет("АктРасхождения");
    ТабДок = Новый ТабличныйДокумент;

    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
    ОбластьСтрока = Макет.ПолучитьОбласть("Строка");

    ОбластьШапка.Параметры.Номер = ОбъектДокумента.Номер;
    ОбластьШапка.Параметры.Дата = ОбъектДокумента.Дата;
    ОбластьШапка.Параметры.Склад = ОбъектДокумента.Склад;
    ТабДок.Вывести(ОбластьШапка);

    Для Каждого Строка Из ОбъектДокумента.Товары Цикл
        Отклонение = Строка.ФактическоеКоличество - Строка.УчетноеКоличество;
        Если Отклонение = 0 Тогда
            Продолжить;
        КонецЕсли;

        ОбластьСтрока.Параметры.Заполнить(Строка);
        ОбластьСтрока.Параметры.Отклонение = Отклонение;
        ТабДок.Вывести(ОбластьСтрока);
    КонецЦикла;

    Возврат ТабДок;
КонецФункции